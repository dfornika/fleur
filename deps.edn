{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        ;; Rhino: pure-Java ECMAScript engine for evaluating CWL expressions
        ;; (the CWL spec defines expressions as ECMAScript 5.1).
        org.mozilla/rhino {:mvn/version "1.7.15"}
        ;; ubergraph: directed-graph model for workflow step dependencies
        ;; (topological ordering, cycle detection, visualization).
        ubergraph/ubergraph {:mvn/version "0.9.0"}}
 ;; JitPack is only used by the optional :cwljava alias below; declaring the repo
 ;; here pulls nothing on its own.
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps {org.clojure/tools.trace {:mvn/version "0.8.0"}
                     djblue/portal {:mvn/version "0.58.5"}}}
  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :jvm-opts ["-Djdk.attach.allowAttachSelf"]
          :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Optional: the cwljava (schema-salad-generated Java SDK) preprocessing
  ;; backend. Built on demand from GitHub via JitPack, so it is NOT part of the
  ;; default build/CI. Enable alongside :test with `clojure -X:test:cwljava`.
  :cwljava {:extra-deps {com.github.common-workflow-language/cwljava
                         {:mvn/version "v2.0.0"}}}}}
